# Amazon source RPM the patches are built against. Bump all three together.
AMZN_VERSION=5.6.40-1.144.amzn1
AMZN_BUILDID=.144

# Release suffixes: our packages are 5.6.40-1.144.<suffix>.amzn1. Both sort newer
# than Amazon's 1.144 build, so they are never "downgraded" by a plain yum update.
FULL_SUFFIX=sec1
MIN_SUFFIX=min1

# deb.sury.org php5.6 version the patches were taken from
SURY_VERSION=5.6.40-105
